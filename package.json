{
  "name": "agent-trail",
  "displayName": "AgentTrail",
  "description": "%extension.description%",
  "version": "1.0.0",
  "publisher": "local",
  "author": "liujw",
  "repository": {
    "type": "git",
    "url": "https://github.com/bouquetrender/cursor-forgery.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:cursorForgery.startSession",
    "onCommand:cursorForgery.resetSession",
    "onView:cursorForgery.changes",
    "onView:cursorForgery.timeline"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cursorForgery.endAgentSession",
        "title": "%command.endAgentSession%",
        "icon": "$(pass)",
        "enablement": "cursorForgery.agentSessionActive && cursorForgery.sessionState == ready"
      },
      {
        "command": "cursorForgery.startSession",
        "title": "%command.startSession%",
        "enablement": "cursorForgery.sessionState != capturing"
      },
      {
        "command": "cursorForgery.resetSession",
        "title": "%command.resetSession%",
        "icon": "$(clear-all)",
        "enablement": "cursorForgery.sessionState == ready"
      },
      {
        "command": "cursorForgery.acceptHunk",
        "title": "%command.acceptHunk%",
        "icon": "$(check)"
      },
      {
        "command": "cursorForgery.rejectHunk",
        "title": "%command.rejectHunk%",
        "icon": "$(discard)"
      },
      {
        "command": "cursorForgery.requestHunkChange",
        "title": "%command.requestHunkChange%",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "cursorForgery.openHunkDiff",
        "title": "%command.openHunkDiff%"
      },
      {
        "command": "cursorForgery.openHunk",
        "title": "%command.openHunk%"
      },
      {
        "command": "cursorForgery.acceptFile",
        "title": "%command.acceptFile%",
        "icon": "$(check-all)"
      },
      {
        "command": "cursorForgery.rejectFile",
        "title": "%command.rejectFile%",
        "icon": "$(discard)"
      },
      {
        "command": "cursorForgery.acceptAll",
        "title": "%command.acceptAll%",
        "icon": "$(check-all)",
        "enablement": "cursorForgery.hasPendingChanges"
      },
      {
        "command": "cursorForgery.rejectAll",
        "title": "%command.rejectAll%",
        "icon": "$(trash)",
        "enablement": "cursorForgery.hasPendingChanges"
      },
      {
        "command": "cursorForgery.addToCodexThread",
        "title": "%command.addToCodexThread%"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "cursorForgery.changes",
          "name": "%view.changes%"
        },
        {
          "id": "cursorForgery.timeline",
          "name": "%view.timeline%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "cursorForgery.changes",
        "contents": "%welcome.start%",
        "when": "cursorForgery.sessionState != capturing && cursorForgery.sessionState != ready && workspaceFolderCount > 0"
      },
      {
        "view": "cursorForgery.changes",
        "contents": "%welcome.workspace%",
        "when": "workspaceFolderCount == 0"
      },
      {
        "view": "cursorForgery.changes",
        "contents": "%welcome.capturing%",
        "when": "cursorForgery.sessionState == capturing"
      },
      {
        "view": "cursorForgery.changes",
        "contents": "%welcome.ready%",
        "when": "cursorForgery.sessionState == ready"
      }
    ],
    "submenus": [
      {
        "id": "cursorForgery.moreReviewActions",
        "label": "%menu.moreReviewActions%"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "cursorForgery.moreReviewActions",
          "when": "resourceScheme == file && cursorForgery.activeFileHasPendingChanges",
          "group": "9_cutcopypaste@10"
        }
      ],
      "cursorForgery.moreReviewActions": [
        {
          "command": "cursorForgery.requestHunkChange",
          "group": "1_review"
        }
      ],
      "commandPalette": [
        {
          "command": "cursorForgery.addToCodexThread",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "cursorForgery.addToCodexThread",
          "when": "resourceScheme == file",
          "group": "4_search@10"
        }
      ],
      "view/title": [
        {
          "command": "cursorForgery.endAgentSession",
          "when": "view == cursorForgery.timeline && cursorForgery.agentSessionActive && cursorForgery.sessionState == ready",
          "group": "navigation@1"
        },
        {
          "command": "cursorForgery.acceptAll",
          "when": "view == cursorForgery.changes && cursorForgery.hasPendingChanges",
          "group": "navigation@1"
        },
        {
          "command": "cursorForgery.rejectAll",
          "when": "view == cursorForgery.changes && cursorForgery.hasPendingChanges",
          "group": "navigation@2"
        },
        {
          "command": "cursorForgery.resetSession",
          "when": "view == cursorForgery.changes && cursorForgery.sessionState == ready",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "submenu": "cursorForgery.moreReviewActions",
          "when": "view == cursorForgery.changes && viewItem == cursorForgery.hunk",
          "group": "1_review"
        },
        {
          "command": "cursorForgery.acceptFile",
          "when": "view == cursorForgery.changes && viewItem == cursorForgery.file",
          "group": "inline@1"
        },
        {
          "command": "cursorForgery.rejectFile",
          "when": "view == cursorForgery.changes && viewItem == cursorForgery.file",
          "group": "inline@2"
        },
        {
          "command": "cursorForgery.acceptHunk",
          "when": "view == cursorForgery.changes && viewItem == cursorForgery.hunk",
          "group": "inline@1"
        },
        {
          "command": "cursorForgery.rejectHunk",
          "when": "view == cursorForgery.changes && viewItem == cursorForgery.hunk",
          "group": "inline@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test:unit": "npm run compile && mocha --ui tdd 'out/test/unit/**/*.test.js'",
    "test:integration": "npm run compile && node ./out/test/runTest.js",
    "test": "npm run test:unit && npm run test:integration"
  },
  "dependencies": {
    "diff": "5.2.0"
  },
  "devDependencies": {
    "@types/diff": "5.2.1",
    "@types/mocha": "10.0.1",
    "@types/node": "16.18.68",
    "@types/vscode": "1.85.0",
    "@vscode/test-electron": "2.3.8",
    "mocha": "10.2.0",
    "typescript": "5.3.3"
  }
}
